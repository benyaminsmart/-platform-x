# Platform-X Environment Configuration
# Copy to .env and adjust for your environment

# Application
APP_NAME=Platform-X
APP_ENV=development          # development | staging | production
APP_DEBUG=true               # MUST be false in production
APP_VERSION=0.1.0

# Server
HOST=0.0.0.0
PORT=8000

# Database
# Local dev (Termux): SQLite
DATABASE_URL=sqlite:///./platform_x.db
# Production (VPS): PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/platform_x

# Security
# Production: SECRET_KEY must be at least 32 chars and NOT the dev default
SECRET_KEY=dev-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256
BCRYPT_ROUNDS=12

# CORS (comma-separated in .env, JSON list in code)
# In production: no localhost/127.0.0.1 entries allowed
CORS_ORIGINS=["http://localhost:8000", "http://127.0.0.1:8000"]

# Multi-tenancy
DEFAULT_TENANT_SLUG=demo

# Feature flags
# MUST be false in production
ENABLE_MOCK_PAYMENTS=true
REFRESH_TOKEN_EXPIRE_DAYS=30


# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=Platform-X
EMAIL_ENABLED=false

# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_ENABLED=false
