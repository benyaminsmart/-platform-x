# ============================================================
# Platform-X — Environment Configuration (EXAMPLE)
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit the real .env to the repository.
#
# Usage:
#   cp .env.example .env
#   nano .env    # edit values
# ============================================================


# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
APP_NAME=Platform-X
APP_ENV=production          # development | staging | production
APP_DEBUG=false             # MUST be false in production
APP_VERSION=1.0.0


# ------------------------------------------------------------
# Server
# ------------------------------------------------------------
HOST=0.0.0.0
PORT=8000


# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
# Development (Termux):
# DATABASE_URL=sqlite:///./platform_x.db
#
# Production (VPS — PostgreSQL):
DATABASE_URL=postgresql://platformx:CHANGE_ME@localhost:5432/platform_x


# ------------------------------------------------------------
# Security
# ------------------------------------------------------------
# MUST be at least 32 random characters in production.
# Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_USE_A_LONG_RANDOM_STRING_HERE
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256
BCRYPT_ROUNDS=12


# ------------------------------------------------------------
# CORS — allowed front-end origins (JSON list)
# ------------------------------------------------------------
# In production: NO localhost / 127.0.0.1 entries.
CORS_ORIGINS=["https://your-domain.example"]


# ------------------------------------------------------------
# Multi-tenancy
# ------------------------------------------------------------
DEFAULT_TENANT_SLUG=demo


# ------------------------------------------------------------
# Feature flags
# ------------------------------------------------------------
ENABLE_MOCK_PAYMENTS=false  # MUST be false in production


# ------------------------------------------------------------
# AI provider (provider-agnostic; mock providers ship with code)
# ------------------------------------------------------------
AI_PROVIDER=gemini          # gemini | openai | anthropic | mock
AI_API_KEY=
AI_MODEL=


# ------------------------------------------------------------
# Email (Resend)
# ------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=onboarding@your-domain.example
EMAIL_FROM_NAME=Platform-X
EMAIL_ENABLED=false


# ------------------------------------------------------------
# SMS (Twilio — optional, Phase 11)
# ------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=


# ------------------------------------------------------------
# Payment provider (Phase 10; provider-agnostic)
# ------------------------------------------------------------
PAYMENT_PROVIDER=mock       # mock | telr | stripe
TELR_STORE_ID=
TELR_AUTH_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=


# ------------------------------------------------------------
# Observability
# ------------------------------------------------------------
LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json             # json | text


# ------------------------------------------------------------
# Rewards engine (all values can also be tuned in the DB)
# ------------------------------------------------------------
REWARD_EXPIRATION_DEFAULT_DAYS=60
REWARD_REFERRAL_REFERRER_CREDIT=20.00
REWARD_REFERRAL_REFERRED_CREDIT=15.00
REWARD_REFERRAL_MIN_QUALIFYING_AMOUNT=300.00
REWARD_REFERRAL_MAX_CREDIT_PER_USER_MONTH=100.00
